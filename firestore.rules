rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function admin() {
      return myProfile() && role() == 'admin';
    }

    function supervisorOrAdmin() {
      return myProfile() && (role() == 'supervisor' || role() == 'admin');
    }

    // Ogni utente autenticato può leggere solo il proprio profilo.
    // Gli admin possono leggere la lista utenti.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if admin();
      allow update, delete: if admin() && uid != request.auth.uid;
    }

    // Placeholder per eventuali dati condivisi futuri.
    // NON usare "allow read, write: if true".
    match /app/{document=**} {
      allow read: if signedIn();
      allow write: if supervisorOrAdmin();
    }
  }
}
